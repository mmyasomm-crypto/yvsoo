# Supabase JWT verification — use ONE of the two:
#
# ROOT-CAUSE NOTE: this file previously shipped with BOTH
# SUPABASE_JWT_SECRET and SUPABASE_URL as unresolved placeholder
# text ("your-supabase-jwt-secret" / "https://your-project.supabase.co").
# If you ran `cp .env.example .env` without editing it, every request
# hit the HS256 branch in app/auth.py with a bogus secret, so EVERY
# token — even a perfectly valid one from a signed-in user — failed
# verification with 401. tryAIErase() in the frontend treats any
# non-2xx response as "AI backend unavailable" and silently falls
# back to the offline heuristic eraser. This is the same class of bug
# as the old placeholder AI_ERASER_API_URL in index.html, just one
# layer deeper (auth instead of routing) — fixed the same way: stop
# shipping a value that can never actually work.
#
# 1) Asymmetric keys (recommended, no secret to manage) — leave
#    SUPABASE_JWT_SECRET EMPTY and set SUPABASE_URL to your real
#    project URL. This backend then verifies tokens against your
#    project's public JWKS (https://<project>.supabase.co/auth/v1/.well-known/jwks.json).
#    Pre-filled below with the same project URL already hardcoded in
#    ../index.html (window.SUPABASE_URL) — this is a public project
#    ref, not a secret, so it's safe to ship as a real default here.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://iftsfzsknxiycqgmgwff.supabase.co
# 2) Legacy HS256 shared secret — ONLY needed if the project above has
#    NOT migrated to asymmetric JWT signing keys (Project Settings >
#    JWT Keys in the Supabase dashboard tells you which mode you're
#    in). If requests still 401 with SUPABASE_URL set as above, your
#    project is still on the legacy secret: get it from Project
#    Settings > API > JWT Secret and put it here instead — this
#    secret is genuinely private and cannot be pre-filled for you.
# SUPABASE_JWT_SECRET=paste-your-legacy-jwt-secret-here
SUPABASE_JWT_AUDIENCE=authenticated

# CORS — comma-separated list of allowed origins.
# CORS_ORIGIN_REGEX below additionally covers common local-dev ports
# (Live Server 5500, Vite 5173, http-server 8080, etc.) so a request
# from "whatever port you happened to serve the frontend on" doesn't
# get silently blocked by the browser (which also looks, from the
# frontend, exactly like "AI backend unavailable" -> silent fallback).
# Tighten CORS_ORIGINS/remove the regex for production deployments.
CORS_ORIGINS=https://your-yofilter-domain.com,http://localhost:8080
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Model
LAMA_MODEL_PATH=/app/models/inpainting_lama.onnx
LAMA_INPUT_SIZE=512
ONNX_PROVIDERS=CPUExecutionProvider
ONNX_INTRA_THREADS=0

# Request limits
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_DIMENSION=2048

# Rate limiting (per authenticated user)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
